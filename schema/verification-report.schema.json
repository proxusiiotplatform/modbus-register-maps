{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/proxusiiotplatform/modbus-register-maps/schema/verification-report.schema.json",
  "title": "Hardware verification report",
  "description": "What a tool such as proxus-mcp's verify_device_map found when it read a map's registers from a real device. Holds check results, not plant data: no addresses, host names or full serial numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "tool", "map", "map_sha256", "date", "level", "registers", "checks"],
  "properties": {
    "report_version": { "const": 1 },
    "tool": { "type": "string", "pattern": "^[A-Za-z0-9 ._+-]{1,64}$" },
    "map": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
    "map_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/text" },
        "firmware": { "$ref": "#/$defs/text" },
        "serial_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "level": { "enum": ["L1", "L2", "L3"] },
    "registers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "read", "unreadable_count", "unreadable"],
      "properties": {
        "checked": { "type": "integer", "minimum": 1 },
        "read": { "type": "integer", "minimum": 0 },
        "not_available": { "type": "integer", "minimum": 0 },
        "unreadable_count": { "type": "integer", "minimum": 0 },
        "unreadable": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/key" } }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
          "key": { "$ref": "#/$defs/key" },
          "passed": { "type": "boolean" },
          "detail": { "$ref": "#/$defs/text" }
        }
      }
    },
    "confirmed": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "device_shows", "read"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "device_shows": { "type": "string", "pattern": "^-?[0-9]+([.,][0-9]+)?$" },
          "read": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[-+]?[0-9]+)?$" },
          "unit": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "text": { "type": "string", "pattern": "^[A-Za-z0-9 ._/()+%°:-]{0,64}$" }
  }
}
